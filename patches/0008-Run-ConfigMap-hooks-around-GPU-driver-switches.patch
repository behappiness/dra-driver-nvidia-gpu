diff --git a/cmd/gpu-kubelet-plugin/vfio-device.go b/cmd/gpu-kubelet-plugin/vfio-device.go
index a67d1ee5..d637d0fe 100644
--- a/cmd/gpu-kubelet-plugin/vfio-device.go
+++ b/cmd/gpu-kubelet-plugin/vfio-device.go
@@ -71,6 +71,8 @@ type VfioPciManager struct {
 	// from the nvidia driver, so they do not block a switch to vfio (e.g.
 	// dcgm-exporter with its bind/unbind watch).
 	releasingHolders []string
+	// nil when no hook ConfigMap is configured.
+	hooks *switchHooks
 
 	inflightDriverSwitches map[string]struct{}
 }
@@ -467,6 +469,10 @@ func (vm *VfioPciManager) changeDriver(pciAddress, driver string) error {
 		}
 	}
 
+	if err := vm.hooks.run(hookStageUnbound, pciAddress, driver); err != nil {
+		return err
+	}
+
 	err = vm.nvlib.nvpasst.BindToDriver(pciAddress, driver)
 	if err != nil {
 		return fmt.Errorf("error binding GPU %q to driver %q: %w", pciAddress, driver, err)
@@ -480,7 +486,7 @@ func (vm *VfioPciManager) changeDriver(pciAddress, driver string) error {
 			return fmt.Errorf("error binding auxiliary devices of GPU %q to vfio: %w", pciAddress, err)
 		}
 	}
-	return nil
+	return vm.hooks.run(hookStageBound, pciAddress, driver)
