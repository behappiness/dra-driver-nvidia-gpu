+package main
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+	corev1 "k8s.io/api/core/v1"
+	apierrors "k8s.io/apimachinery/pkg/api/errors"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/apimachinery/pkg/runtime/schema"
+)
+
+type fakeConfigMaps map[string]*corev1.ConfigMap
+
+func (f fakeConfigMaps) Get(_ context.Context, name string, _ metav1.GetOptions) (*corev1.ConfigMap, error) {
+	if cm, ok := f[name]; ok {
+		return cm, nil
+	}
+	return nil, apierrors.NewNotFound(schema.GroupResource{Resource: "configmaps"}, name)
+}
+
+func TestSwitchHooks(t *testing.T) {
+	log := filepath.Join(t.TempDir(), "log")
+	record := func(tag string) string {
+		return `echo "` + tag + ` $PCI_ADDRESS $DRIVER" >> ` + log
+	}
+	hooks := func(data map[string]string) *switchHooks {
+		return &switchHooks{configMaps: fakeConfigMaps{"hooks": {Data: data}}, name: "hooks"}
+	}
+	readLog := func() string {
+		b, err := os.ReadFile(log)
+		if os.IsNotExist(err) {
+			return ""
+		}
+		require.NoError(t, err)
+		require.NoError(t, os.Remove(log))
+		return string(b)
+	}
+
+	t.Run("runs the stage's entries in key order", func(t *testing.T) {
+		h := hooks(map[string]string{
+			"unbound.b-second": record("b"),
+			"unbound.a-first":  record("a"),
+			"bound.other":      record("bound"),
+			"unboundx":         record("no stage separator"),
+		})
+		require.NoError(t, h.run(hookStageUnbound, "0000:02:00.0", "nvidia"))
+		require.Equal(t, "a 0000:02:00.0 nvidia\nb 0000:02:00.0 nvidia\n", readLog())
+	})
+
+	t.Run("a failing hook fails the switch and stops the rest", func(t *testing.T) {
+		h := hooks(map[string]string{
+			"bound.a": "exit 3",
+			"bound.b": record("b"),
+		})
+		err := h.run(hookStageBound, "0000:02:00.0", "vfio-pci")
+		require.ErrorContains(t, err, `hook "bound.a" for GPU "0000:02:00.0" failed`)
+		require.Empty(t, readLog())
+	})
+
+	t.Run("no hooks configured", func(t *testing.T) {
+		var h *switchHooks
+		require.NoError(t, h.run(hookStageBound, "0000:02:00.0", "nvidia"))
+	})
+
+	t.Run("a missing ConfigMap fails the switch", func(t *testing.T) {
+		h := &switchHooks{configMaps: fakeConfigMaps{}, name: "hooks"}
+		require.ErrorContains(t, h.run(hookStageUnbound, "0000:02:00.0", "nvidia"), `error getting hook ConfigMap "hooks"`)
+	})
+}
