diff --git a/cmd/gpu-kubelet-plugin/vfio-hooks.go b/cmd/gpu-kubelet-plugin/vfio-hooks.go
new file mode 100644
index 00000000..115a5fc4
--- /dev/null
+++ b/cmd/gpu-kubelet-plugin/vfio-hooks.go
@@ -0,0 +1,82 @@
