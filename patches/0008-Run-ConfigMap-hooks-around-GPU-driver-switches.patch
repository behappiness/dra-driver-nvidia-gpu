+
+package main
+
+import (
+	"context"
+	"fmt"
+	"os"
+	"os/exec"
+	"slices"
+	"strings"
+
+	corev1 "k8s.io/api/core/v1"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/klog/v2"
+)
+
+// Stages of a GPU driver switch at which hooks run.
+const (
+	// The GPU has no driver; the target driver binds next.
+	hookStageUnbound = "unbound"
+	// The target driver is bound (on vfio, the auxiliary function too).
+	hookStageBound = "bound"
+)
+
+type configMapGetter interface {
+	Get(ctx context.Context, name string, opts metav1.GetOptions) (*corev1.ConfigMap, error)
+}
+
+// switchHooks runs host-specific steps around a driver switch, such as a bus
+// reset or a power limit. They are shell scripts in a ConfigMap, read at every
+// switch: the entries named "<stage>.<name>", in key order. A failing hook
+// fails the switch.
+type switchHooks struct {
+	configMaps configMapGetter
+	name       string
+}
+
+func (h *switchHooks) run(stage, pciAddress, driver string) error {
+	if h == nil {
+		return nil
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), driverChangeTimeout)
+	defer cancel()
+
+	cm, err := h.configMaps.Get(ctx, h.name, metav1.GetOptions{})
+	if err != nil {
+		return fmt.Errorf("error getting hook ConfigMap %q: %w", h.name, err)
+	}
+	var keys []string
+	for key := range cm.Data {
+		if strings.HasPrefix(key, stage+".") {
+			keys = append(keys, key)
+		}
+	}
+	slices.Sort(keys)
+
+	for _, key := range keys {
+		cmd := exec.CommandContext(ctx, "sh", "-c", cm.Data[key])
+		cmd.Env = append(os.Environ(), "PCI_ADDRESS="+pciAddress, "DRIVER="+driver)
+		out, err := cmd.CombinedOutput()
+		klog.Infof("Hook %q for GPU %q (driver %q): %s", key, pciAddress, driver, strings.TrimSpace(string(out)))
+		if err != nil {
+			return fmt.Errorf("hook %q for GPU %q failed: %w", key, pciAddress, err)
+		}
+	}
+	return nil
+}
