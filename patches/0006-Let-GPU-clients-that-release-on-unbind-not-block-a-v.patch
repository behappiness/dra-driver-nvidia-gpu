+func TestBlockingHolders(t *testing.T) {
+	dcgm := gpuHolder{pid: "10", exe: "dcgm-exporter"}
+	persistenced := gpuHolder{pid: "11", exe: "nvidia-persistenced"}
+	unknown := gpuHolder{pid: "12"}
+
+	tests := map[string]struct {
+		releasing []string
+		holders   []gpuHolder
+		want      []gpuHolder
+	}{
+		"no holders":                  {releasing: []string{"dcgm-exporter"}},
+		"nothing releases by default": {holders: []gpuHolder{dcgm}, want: []gpuHolder{dcgm}},
+		"only releasing holders":      {releasing: []string{"dcgm-exporter"}, holders: []gpuHolder{dcgm}},
+		"other holders still block": {
+			releasing: []string{"dcgm-exporter"},
+			holders:   []gpuHolder{dcgm, persistenced},
+			want:      []gpuHolder{persistenced},
+		},
+		"unreadable exe blocks": {
+			releasing: []string{""},
+			holders:   []gpuHolder{unknown},
+			want:      []gpuHolder{unknown},
+		},
+	}
+
+	for name, tc := range tests {
+		t.Run(name, func(t *testing.T) {
+			vm := &VfioPciManager{releasingHolders: tc.releasing}
+			require.Equal(t, tc.want, vm.blockingHolders(tc.holders))
+		})
+	}
+}
+
+func TestSplitList(t *testing.T) {
+	require.Nil(t, splitList(""))
+	require.Equal(t, []string{"dcgm-exporter", "nv-hostengine"}, splitList(" dcgm-exporter,,nv-hostengine "))
+}
