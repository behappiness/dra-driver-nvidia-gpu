@@ -222,16 +231,56 @@ func checkHostPIDNamespace(procRoot string) error {
 	return nil
 }
 
-// findCharDeviceHolders returns "<pid>(<exe>)" for every process under procRoot
+// blockingHolders returns the holders not known to release the GPU on unbind.
+func (vm *VfioPciManager) blockingHolders(holders []gpuHolder) []gpuHolder {
+	var blocking []gpuHolder
+	for _, h := range holders {
+		if h.exe == "" || !slices.Contains(vm.releasingHolders, h.exe) {
+			blocking = append(blocking, h)
+		}
+	}
+	return blocking
+}
+
+// gpuHolder is a process holding an open fd to a GPU device node.
+type gpuHolder struct {
+	pid string
+	exe string
+}
+
+func (h gpuHolder) String() string {
+	return fmt.Sprintf("%s(%s)", h.pid, h.exe)
+}
+
+func joinHolders(holders []gpuHolder) string {
+	names := make([]string, len(holders))
+	for i, h := range holders {
+		names[i] = h.String()
+	}
+	return strings.Join(names, ",")
+}
+
+// splitList splits a comma-separated flag value, dropping empty entries.
+func splitList(s string) []string {
+	var out []string
+	for _, v := range strings.Split(s, ",") {
+		if v = strings.TrimSpace(v); v != "" {
+			out = append(out, v)
+		}
+	}
+	return out
+}
+
+// findCharDeviceHolders returns every process under procRoot
 // holding an open fd to the character device major:minor. Processes and fds
 // that disappear mid-scan are skipped; any other error fails the scan, since
 // a process it cannot inspect may be holding the device.
-func findCharDeviceHolders(procRoot string, major, minor uint32) ([]string, error) {
+func findCharDeviceHolders(procRoot string, major, minor uint32) ([]gpuHolder, error) {
 	procs, err := os.ReadDir(procRoot)
 	if err != nil {
 		return nil, fmt.Errorf("error listing %q: %w", procRoot, err)
 	}
-	var holders []string
+	var holders []gpuHolder
 	for _, p := range procs {
 		// Only the numeric entries of /proc are processes; the rest (self,
 		// sys, meminfo, ...) are kernel interfaces.
@@ -263,7 +312,7 @@ func findCharDeviceHolders(procRoot string, major, minor uint32) ([]string, erro
 			// st_rdev, regardless of the node's name or location.
 			rdev := uint64(st.Rdev) //nolint:gosec,unconvert
 			if uint32(st.Mode)&unix.S_IFMT == unix.S_IFCHR && unix.Major(rdev) == major && unix.Minor(rdev) == minor {
-				holders = append(holders, fmt.Sprintf("%s(%s)", p.Name(), processExeName(procRoot, p.Name())))
+				holders = append(holders, gpuHolder{pid: p.Name(), exe: processExeName(procRoot, p.Name())})
 				break
 			}
 		}
