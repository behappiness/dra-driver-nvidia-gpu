-	self := fmt.Sprintf("%d(%s)", os.Getpid(), filepath.Base(exe))
+	require.Empty(t, holders)
+
+	_, err = findCharDeviceHolders(filepath.Join(procRoot, "missing"), 1, 3)
+	require.Error(t, err)
 
+	if os.Geteuid() != 0 {
+		// A process whose fds cannot be read fails the scan: it may hold the GPU.
+		fdDir := filepath.Join(addProc("103", "/usr/bin/hidden"), "fd")
+		require.NoError(t, os.Chmod(fdDir, 0))
+		t.Cleanup(func() { _ = os.Chmod(fdDir, 0o755) })
+		_, err = findCharDeviceHolders(procRoot, 1, 3)
+		require.Error(t, err)
+	}
