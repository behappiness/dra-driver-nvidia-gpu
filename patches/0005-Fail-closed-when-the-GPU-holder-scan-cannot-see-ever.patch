-	f, err := os.Open("/dev/null")
+	// A procfs-like tree: an exe link and fd links per pid. Stat follows the
+	// fd links, so /dev/null stands in for a held GPU node (char device 1:3).
+	procRoot := t.TempDir()
+	addProc := func(pid, exe string, fds ...string) string {
+		dir := filepath.Join(procRoot, pid)
+		require.NoError(t, os.MkdirAll(filepath.Join(dir, "fd"), 0o755))
+		require.NoError(t, os.Symlink(exe, filepath.Join(dir, "exe")))
