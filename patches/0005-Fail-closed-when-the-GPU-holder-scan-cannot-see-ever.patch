-// holding an open fd to the character device major:minor. Processes that exit
-// or whose fds cannot be read mid-scan are skipped.
+// holding an open fd to the character device major:minor. Processes and fds
+// that disappear mid-scan are skipped; any other error fails the scan, since
+// a process it cannot inspect may be holding the device.
 func findCharDeviceHolders(procRoot string, major, minor uint32) ([]string, error) {
 	procs, err := os.ReadDir(procRoot)
 	if err != nil {
@@ -218,13 +239,14 @@ func findCharDeviceHolders(procRoot string, major, minor uint32) ([]string, erro
 			continue
 		}
 		// /proc/<pid>/fd holds one symlink per open fd. Listing it fails with
-		// ENOENT for a process that exited mid-scan, and with EACCES for one
-		// we may not inspect, which the privileged plugin does not expect;
-		// either way there is nothing to check, so skip it.
+		// ENOENT (or ESRCH) for a process that exited mid-scan.
 		fdDir := filepath.Join(procRoot, p.Name(), "fd")
 		fds, err := os.ReadDir(fdDir)
 		if err != nil {
-			continue
+			if isGoneErr(err) {
+				continue
+			}
+			return nil, fmt.Errorf("error listing open fds of process %s: %w", p.Name(), err)
 		}
 		for _, fd := range fds {
 			// Stat follows the fd symlink to the open file itself, so this
@@ -232,7 +254,10 @@ func findCharDeviceHolders(procRoot string, major, minor uint32) ([]string, erro
 			// that does not exist in our mount namespace.
 			var st unix.Stat_t
 			if err := unix.Stat(filepath.Join(fdDir, fd.Name()), &st); err != nil {
-				continue
+				if isGoneErr(err) {
+					continue
+				}
+				return nil, fmt.Errorf("error inspecting fd %s of process %s: %w", fd.Name(), p.Name(), err)
 			}
 			// A character device is identified by the major:minor packed into
 			// st_rdev, regardless of the node's name or location.
@@ -246,6 +271,11 @@ func findCharDeviceHolders(procRoot string, major, minor uint32) ([]string, erro
 	return holders, nil
 }
 
+// isGoneErr reports whether err means the process or fd went away mid-scan.
+func isGoneErr(err error) bool {
+	return errors.Is(err, fs.ErrNotExist) || errors.Is(err, unix.ESRCH)
+}
